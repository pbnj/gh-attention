{
  "config": {
    // oxfmt owns formatting (it follows Prettier), so turn off the rules
    // that conflict with a Prettier-style formatter.
    "extends": "markdownlint/style/prettier"
  },
  "globs": ["**/*.md"],
  // Generated by release-please; its format isn't ours to lint.
  "ignores": ["CHANGELOG.md"],
  "gitignore": true
}
